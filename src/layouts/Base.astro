---
import "../styles/global.css";
import "../styles/workspace.css";
import "katex/dist/katex.min.css";
import { site } from "../config";
import Search from "../components/Search";

import { fontStyles } from "../lib/fonts";
const {
  title = site.title,
  description = site.description,
  articleDate,
  image,
  noindex = false,
} = Astro.props;
const readingFonts = [site.fonts.body, site.fonts.heading].join(" ");
const preloadFonts = readingFonts.includes("misans") ? ["MiSans-Regular.woff2", "MiSans-Bold.woff2", "MiSans-Medium.woff2"] : [];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-theme={site.theme} style={fontStyles(site.fonts)}>
  <head>
    <meta charset="UTF-8" />
    {preloadFonts.map(file => <link rel="preload" href={"/fonts/"+file} as="font" type="font/woff2" crossorigin="anonymous" />)}
    <meta name="viewport" content="width=device-width" />
    <title>{title===site.title?title:title+' · '+site.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.title} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {articleDate && (
      <meta property="article:published_time" content={articleDate} />
    )}
    {image && (
      <meta property="og:image" content={new URL(image, Astro.site).href} />
    )}
    <link rel="icon" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href="/rss.xml"
    />
    <script is:inline>
      try {
        const m = localStorage.getItem("mode");
        document.documentElement.classList.toggle(
          "dark",
          m ? m === "dark" : matchMedia("(prefers-color-scheme: dark)").matches,
        );
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      跳至正文
    </a>
    <header class="site-header">
      <a href="/" class="brand">
        <span class="brand-icon">m.</span>页间
      </a>
      {site.theme === "workspace" && (
        <p class="sidebar-note">
          一个持续更新的
          <br />
          个人创作空间。
        </p>
      )}
      <nav aria-label="主导航">
        {site.theme === "workspace" && (
          <a
            href="/"
            aria-current={Astro.url.pathname === "/" ? "page" : undefined}
          >
            工作台
          </a>
        )}
        {site.navigation.map((n) => (
          <a
            href={n.href}
            aria-current={
              Astro.url.pathname.startsWith(n.href) ? "page" : undefined
            }
          >
            {n.label}
          </a>
        ))}
      </nav>
      <div class="tools">
        <Search client:load />

        <button id="mode" aria-label="切换亮暗模式">
          ◐
        </button>
      </div>
      {site.theme === "workspace" && (
        <a class="sidebar-subscribe" href="/rss.xml">
          通过 RSS 订阅
        </a>
      )}
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <a class="brand" href="/">
        页间
      </a>
      <span>保持好奇，缓慢生长。</span>
      <div>
        {site.social.map((s) => (
          <a href={s.href}>{s.label}</a>
        ))}
        <span>
          © {new Date().getFullYear()} {site.author}
        </span>
      </div>
    </footer>
    <script>
      document.querySelector("#mode")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("mode", dark ? "dark" : "light");
        } catch {}
      });
    </script>
  </body>
</html>
