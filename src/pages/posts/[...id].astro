---
import Base from "../../layouts/Base.astro";
import { published, dateLabel } from "../../lib/content";
import { render } from "astro:content";
import TsxContent from "../../components/TsxContent";
import { site } from "../../config";
export async function getStaticPaths() {
  return (await published()).map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const rendered = post.kind === "markdown" ? await render(post) : null;
const Content = rendered?.Content;
const headings =
  post.kind === "tsx" ? post.data.headings : rendered?.headings || [];
const related = (await published())
  .filter(
    (p) =>
      p.id !== post.id && p.data.tags.some((t) => post.data.tags.includes(t)),
  )
  .slice(0, 3);
const layout = post.data.template || site.defaultLayout;
---

<Base
  title={post.data.title}
  description={post.data.description}
  articleDate={post.data.date.toISOString()}
  image={post.data.cover}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      author: { "@type": "Person", name: site.author },
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
      ...(post.data.cover
        ? { image: new URL(post.data.cover, Astro.site).href }
        : {}),
    }).replace(/</g, "\\u003c")}
  />
  <div id="reading-progress" aria-hidden="true"></div>
  <article class:list={["article", "layout-" + layout]}>
    <header class="article-heading">
      <a class="eyebrow" href="/posts/">
        返回全部文章
      </a>
      <div class="tags">
        {post.data.tags.map((t) => (
          <a href={"/tags/" + encodeURIComponent(t) + "/"}>{t}</a>
        ))}
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-meta">
        {site.author} ·{" "}
        <time datetime={post.data.date.toISOString()}>
          {dateLabel(post.data.date)}
        </time>{" "}
        · {Math.max(1, Math.ceil((post.body?.length || 0) / 500))} 分钟阅读
      </div>
      {post.data.cover && (
        <img class="cover" src={post.data.cover} alt={post.data.title} />
      )}
    </header>
    <div class="article-grid">
      <aside class="toc">
        <details open>
          <summary>本页目录</summary>
          {headings
            .filter((h) => h.depth <= 3)
            .map((h) => (
              <a
                style={"padding-left:" + (h.depth - 2) * 12 + "px"}
                href={"#" + h.slug}
              >
                {h.text}
              </a>
            ))}
        </details>
      </aside>
      <div class="prose" id="article-body">
        {post.kind === "tsx" ? (
          <TsxContent id={post.id} client:visible />
        ) : (
          Content && <Content />
        )}
      </div>
    </div>
    <section class="related">
      <h2>继续探索</h2>
      {related.length ? (
        related.map((p) => (
          <a href={"/posts/" + p.id + "/"}>{p.data.title} ↗</a>
        ))
      ) : (
        <a href="/posts/">浏览全部文章 ↗</a>
      )}
    </section>
  </article>
  <script src="../../scripts/article.ts"></script>
</Base>
