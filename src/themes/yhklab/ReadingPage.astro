---
import Shell from "./Shell.astro";
import { readingArticle } from "./readingArticle";
import type { Entry } from "./blocks";
import type { ArticleHeading, NativeComponent } from "../openai/types";

interface Props {
  entry: Entry;
  components?: Record<string, NativeComponent>;
  sections?: ArticleHeading[];
  mock?: boolean;
  tools?: boolean;
  byline?: boolean;
  next?: boolean;
}
const {
  entry,
  components = {},
  sections = [],
  mock = false,
  tools = true,
  byline = true,
  next = true,
} = Astro.props;
const body = (await Astro.slots.render("default")) ?? "";
const article = readingArticle({ entry, body, sections, tools, byline, next });
---

<Shell
  {components}
  title={entry.title}
  description={entry.description}
  {mock}
  body={article}
/>
