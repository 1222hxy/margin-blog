t-primary-60 transition-[background-color,color,opacity,transform] duration-short ease-curve-a focus-visible:z-1 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary-44 active:scale-98 w-full rounded-full hover:bg-primary-4\"><span class=\"text-balance\">Ramp</span></button></li><li class=\"min-w-0 px-1\" style=\"flex:0 0 33.333333333333336%\"><button type=\"button\" aria-current=\"false\" aria-label=\"显示来自 Jump Trading 的推荐语\" class=\"relative flex min-h-11 items-center justify-center bg-transparent p-2 text-center text-caption text-primary-60 transition-[background-color,color,opacity,transform] duration-short ease-curve-a focus-visible:z-1 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary-44 active:scale-98 w-full rounded-full hover:bg-primary-4\"><span class=\"text-balance\">Jump Trading</span></button></li></ul></div></div></div></section></div></div></div><!--/$--></div></div></div></div></div>",
